      "post": {
        "description": "Stores credentials encrypted, then attempts a connection. Responds 201 either way; status is CONNECTED (schemas discovered) or ERROR (statusMessage explains why).",
        "operationId": "DataSourcesController_create",
        "parameters": [
          {
            "name": "X-Organization-Id",
            "in": "header",
            "description": "Organization UUID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "POSTGRESQL"
                    ]
                  },
                  "config": {
                    "type": "object",
                    "properties": {
                      "host": {
                        "type": "string",
                        "minLength": 1
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535,
                        "default": 5432
                      },
                      "database": {
                        "type": "string",
                        "minLength": 1
                      },
                      "schema": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sslmode": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "host",
                      "database"
                    ],
                    "additionalProperties": false
                  },
                  "credentials": {
                    "type": "object",
                    "properties": {
                      "user": {
                        "type": "string",
                        "minLength": 1
                      },
                      "password": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "user",
                      "password"
                    ],
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "type",
                  "config",
                  "credentials"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Register a Postgres data source",
        "tags": [
          "data-sources"
        ]
      }
    },
