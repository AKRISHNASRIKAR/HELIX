{
  "name": "@helix/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Hosts and executes agents (FinanceAgent, AnalyticsAgent, ...) behind a common BaseAgent contract",
  "scripts": {
    "build": "true",
    "dev": "SERVICE_PORT=8001 bash ../../scripts/python-run.sh dev",
    "lint": "bash ../../scripts/python-run.sh lint",
    "test": "bash ../../scripts/python-run.sh test",
    "typecheck": "bash ../../scripts/python-run.sh typecheck",
    "clean": "rm -rf .venv .pytest_cache **/__pycache__"
  }
}
