{
  "name": "@helix/mcp-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server (streamable HTTP) exposing the demo deployments feed as a list_deployments tool",
  "scripts": {
    "build": "true",
    "dev": "SERVICE_PORT=${MCP_DEMO_PORT:-8006} bash ../../scripts/python-run.sh dev",
    "lint": "bash ../../scripts/python-run.sh lint",
    "test": "bash ../../scripts/python-run.sh test",
    "typecheck": "bash ../../scripts/python-run.sh typecheck",
    "clean": "rm -rf .venv .pytest_cache **/__pycache__"
  }
}
