# Copy this file to .env and fill in real values for local development.
# Never commit .env. Only .env.example (with placeholders) is tracked.

# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres (packages/database is the only owner of schema/migrations) ---
POSTGRES_USER=helix
POSTGRES_PASSWORD=helix
POSTGRES_DB=helix
POSTGRES_PORT=5432
DATABASE_URL="postgresql://helix:helix@localhost:5432/helix?schema=public"

# --- Redis (cache / queues / short-lived state only, never source of truth) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- apps/api (NestJS) ---
API_PORT=4000
WEB_APP_URL="http://localhost:3000"
# Auth. The API refuses to boot with the dev-default secrets when NODE_ENV=production.
JWT_SECRET="dev-only-change-me-please-32-chars-min"
JWT_EXPIRES_IN=12h
# AES-256-GCM key for data source credentials (base64, must decode to 32 bytes).
# Generate one with: openssl rand -base64 32   (see docs/decisions/ADR-006)
HELIX_SECRETS_KEY="ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE="
# Where uploaded CSVs are stored (relative paths resolve against apps/api).
HELIX_UPLOAD_DIR=.data/uploads
# Set to 1 to serve fixture data with no Postgres/Redis/auth (api + web).
# HELIX_DEMO=1

# --- Service-to-service ---
# Shared token for /api/v1/internal/* and calls between services.
HELIX_INTERNAL_TOKEN=dev-internal-token
HELIX_API_URL="http://localhost:4000"
INGESTION_SERVICE_URL="http://localhost:8004"
AGENT_RUNTIME_URL="http://localhost:8001"
ANALYTICS_ENGINE_URL="http://localhost:8002"

# --- apps/web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_PORT=3000

# --- services/* (FastAPI) ---
AGENT_RUNTIME_PORT=8001
ANALYTICS_ENGINE_PORT=8002
CONTEXT_ENGINE_PORT=8003
INGESTION_SERVICE_PORT=8004
A2A_GATEWAY_PORT=8005

# --- LLM provider (not used yet) ---
# Agent planning and synthesis are deterministic today (ADR-007). An LLM-backed
# planner would only ever interpret and plan, never compute numbers (ADR-005).
ANTHROPIC_API_KEY=
