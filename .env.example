# Copy this file to .env and fill in real values for local development.
# Never commit .env. Only .env.example (with placeholders) is tracked.

# --- Shared ---
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres (packages/database is the only owner of schema/migrations) ---
POSTGRES_USER=helix
POSTGRES_PASSWORD=helix
POSTGRES_DB=helix
POSTGRES_PORT=5432
DATABASE_URL="postgresql://helix:helix@localhost:5432/helix?schema=public"

# --- Redis (cache / queues / short-lived state only, never source of truth) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- apps/api (NestJS) ---
API_PORT=4000
WEB_APP_URL="http://localhost:3000"
# Auth. The API refuses to boot with the dev-default secrets when NODE_ENV=production.
JWT_SECRET="dev-only-change-me-please-32-chars-min"
JWT_EXPIRES_IN=12h
# AES-256-GCM key for data source credentials (base64, must decode to 32 bytes).
# Generate one with: openssl rand -base64 32   (see docs/decisions/ADR-006)
HELIX_SECRETS_KEY="ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE="
# Where uploaded CSVs are stored (relative paths resolve against apps/api).
HELIX_UPLOAD_DIR=.data/uploads
# Set to 1 to serve fixture data with no Postgres/Redis/auth (api + web).
# HELIX_DEMO=1

# --- Service-to-service ---
# Shared token for /api/v1/internal/* and calls between services.
HELIX_INTERNAL_TOKEN=dev-internal-token
HELIX_API_URL="http://localhost:4000"
INGESTION_SERVICE_URL="http://localhost:8004"
AGENT_RUNTIME_URL="http://localhost:8001"
ANALYTICS_ENGINE_URL="http://localhost:8002"
CONTEXT_ENGINE_URL="http://localhost:8003"
A2A_GATEWAY_URL="http://localhost:8005"
# How the Coordinator dispatches tasks to agents: "gateway" routes them through
# services/a2a-gateway over Redis pub/sub (falls back to in-process if the
# gateway is unreachable); "inprocess" calls agents directly.
HELIX_A2A_MODE=gateway
# Local demo MCP server (services/mcp-demo) serving a seeded deployments feed.
MCP_DEMO_PORT=8006

# --- Autonomous monitoring (Phase 9) ---
# How often the API runs enabled monitors, in ms (0 disables the background loop;
# monitors can still be run on demand).
HELIX_MONITOR_INTERVAL_MS=900000
# At most this many autonomous investigations per organization per day.
HELIX_MONITOR_MAX_PER_DAY=5

# --- apps/web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_PORT=3000

# --- services/* (FastAPI) ---
AGENT_RUNTIME_PORT=8001
ANALYTICS_ENGINE_PORT=8002
CONTEXT_ENGINE_PORT=8003
INGESTION_SERVICE_PORT=8004
A2A_GATEWAY_PORT=8005

# --- LLM (optional) ---
# When ANTHROPIC_API_KEY is set, the Coordinator uses Claude to plan which agents
# to involve and to write the investigation summary. Without it (or with
# HELIX_LLM=off) the deterministic rules run instead. Either way every number
# still comes from services/analytics-engine (ADR-005).
ANTHROPIC_API_KEY=
HELIX_LLM=auto
HELIX_LLM_MODEL=claude-opus-5-5
